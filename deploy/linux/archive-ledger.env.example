NODE_ENV=production
PORT=8080
ARCHIVE_DB_PATH=/var/lib/archive-ledger/archive.sqlite
ARCHIVE_STATIC_DIR=/opt/archive-ledger/current/frontend/dist-production
# Replace with the exact LAN HTTPS origin; do not use a wildcard.
ARCHIVE_ALLOWED_ORIGINS=https://archives.example.invalid
ARCHIVE_COOKIE_SECURE=1
ARCHIVE_TRUST_PROXY=1
ARCHIVE_BACKUP_DIR=/var/backups/archive-ledger
